# mithraa.SHI — environment template
#
# Copy to `.env.local` for local work. Never put real values in this file.
# Sign-in is mandatory (Phase 1B): without the two Supabase values below the app
# still starts, but every workspace route redirects to /login and nobody can sign in.
#
# The server port is NOT read from .env files (verified on Next 16.4.2). Use
# `npm run dev -- -p 3001` or set PORT in the shell before `npm start`.

# --- Supabase (auth + Project Brain) -----------------------------------------
# Local: copy API_URL and PUBLISHABLE_KEY from `supabase status -o env`.
# Production: use the production Supabase project. Any staging/Preview that
# enables Groq MUST instead use a different Supabase project and dedicated
# staging auth/DB credentials. Do NOT target production data from Preview.
# NEXT_PUBLIC_* values reach the browser bundle; only publishable keys belong
# here. Secret / service_role
# keys must never get a NEXT_PUBLIC_ prefix. Only the trusted Phase 1C.3b server worker uses a service-role JWT.
NEXT_PUBLIC_SUPABASE_URL=REPLACE_WITH_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY

# Optional. The origin Supabase sends people back to after Google sign-in,
# email confirmation and password reset (e.g. https://app.example.com, no
# trailing slash). Unset: the request's Origin header is used, which suits
# localhost and Vercel preview URLs. Whatever it resolves to must be listed in
# Supabase > Authentication > URL Configuration as <origin>/auth/callback**.
# SITE_URL=REPLACE_WITH_APP_ORIGIN

# --- Local Supabase CLI only (supabase/config.toml) ---------------------------
# Read by `supabase start`, not by the app. Dummies are fine for the automated
# tests; use a real Google OAuth client to click through Google locally.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET

# --- Next.js CLI (optional) --------------------------------------------------
# Opt out of anonymous Next.js telemetry (1 = disabled). Verified to work from
# .env.local for `next build` (dotenv loads before telemetry starts).
# NEXT_TELEMETRY_DISABLED=1

# --- Groq (Phase 1C.2, server-side only) ------------------------------------
# Get a key from https://console.groq.com/keys.
# Configure GROQ_API_KEY in local .env.local and in Vercel server environments.
# NEVER prefix it with NEXT_PUBLIC_, send it to browser JS, or commit the real key.
# Phase 1C.2 adds a tested provider adapter; the authenticated worker/route
# will consume it in Phase 1C.3. No API calls are performed just by setting it.
# GROQ_API_KEY=REPLACE_WITH_SERVER_SIDE_GROQ_KEY

# --- Home Groq execution: explicit opt-in (Phase 1C.3b) ----------------------
# No billable model call can start unless the flag, two private keys AND
# an approved test user's Supabase Auth UUID are configured.
# Keep disabled on Production and Preview by default.
# For an owner-approved SHORT production-only smoke test, the production flag
# can be temporarily enabled after full review, backup and Groq spend controls.
# That is NOT authorization for general public agent access.
# A staging Preview connected to production Supabase is NOT isolated.
HOME_GROQ_EXECUTION_ENABLED=false
#
# Groq key (already described above): GROQ_API_KEY=...
# This MUST be the legacy Supabase service_role JWT for the linked project,
# not the publishable key, anon key, or a browser-exposed NEXT_PUBLIC_* value.
# The new DB worker RPCs require auth.role() = 'service_role'.
# Add only as a secret on the server: never commit a real value.
# SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_JWT
#
# REQUIRED for temporary production smoke tests: only this signed-in Supabase
# Auth user UUID can queue or advance Groq runs while execution is enabled.
# Without a valid UUID, paid execution is denied even when the flag is true.
# HOME_GROQ_TEST_USER_ID=REPLACE_WITH_TEST_USER_UUID
#
# Owner-triggered /api/home/runs/[runId]/advance invokes ONE step per call.
# No cron/background process is scheduled by this phase; a future UI can
# resume delayed runs by retrying after next_attempt_at.
